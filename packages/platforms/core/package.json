{
  "name": "@nedia-matrix/platform-core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./platform-module": {
      "types": "./src/platform-module.ts",
      "import": "./dist/platform-module.js",
      "default": "./dist/platform-module.js"
    },
    "./registry": {
      "types": "./src/registry.ts",
      "import": "./dist/registry.js",
      "default": "./dist/registry.js"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nedia-matrix/automation-contracts": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nedia-matrix/tsconfig": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
